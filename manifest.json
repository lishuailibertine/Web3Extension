{
    "manifest_version": 3,
    "name": "web3app",
    "version": "1.0",
    "description": "A Chrome extension built with Vue.js",
    "action": {
      "default_popup": "dist/index.html",
      "default_icon": {}
    },
    "background": {
      "service_worker": "background.js"
    },
    "host_permissions": ["<all_urls>"],
    "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["scripts/web3-content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
    ],
    "web_accessible_resources": [
    {
      "resources": ["scripts/inject.js"],
      "matches": ["<all_urls>"]
    }
   ],
    "permissions": [
        "storage",
        "unlimitedStorage",
        "clipboardWrite",
        "activeTab",
        "notifications",
        "tabs"
      ]
  }